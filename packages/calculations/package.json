{
  "name": "@agroemprende/calculations",
  "version": "0.1.0",
  "private": true,
  "description": "Motor de calculos financieros y productivos. Funciones puras, sin IO, con pruebas exhaustivas.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
