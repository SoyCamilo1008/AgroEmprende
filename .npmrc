# Gestión estricta de versiones de Node
engine-strict=true
# pnpm instala pares automáticamente (compatible con el hoisting de Turborepo)
auto-install-peers=true
strict-peer-dependencies=false
# Evitar scripts de postinstall de dependencias que no necesitamos en CI
# (se permiten los de husky/next/expo, que son propios)
resolution-mode=highest
