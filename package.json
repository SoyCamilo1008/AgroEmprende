{
  "name": "agroemprende",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma agroempresarial: produccion, animales, finanzas, inventarios y AgroIA.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm tooling:check",
    "clean": "turbo run clean",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:diff": "supabase db diff",
    "migrations:new": "supabase migration new",
    "migrations:list": "supabase migration list",
    "tooling:check-migrations": "node tools/check-migrations.mjs",
    "tooling:check-schema": "node tools/check-schema.mjs",
    "tooling:check": "pnpm tooling:check-migrations && pnpm tooling:check-schema",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "supabase": "^2.118.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
