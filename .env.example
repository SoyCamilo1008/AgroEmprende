# ═══════════════════════════════════════════════════════════════════════════
# AgroEmprende — PLANTILLA de variables de entorno
# ═══════════════════════════════════════════════════════════════════════════
# Copia este archivo a `.env.local` (web) o `.env` (Supabase CLI / Edge Functions)
# y reemplaza los valores. NUNCA commitees el archivo resultante: está en .gitignore
#
#   cp .env.example .env.local      # desarrollo local, apps/web
#
# Reglas de seguridad:
#   • Las variables NEXT_PUBLIC_* / EXPO_PUBLIC_* viajan al navegador o al móvil.
#     SOLO pueden contener la URL de Supabase y la ANON key (que están protegidas
#     por RLS). JAMÁS un service role key ni una API key de IA.
#   • Las variables sin prefijo son SECRETAS: solo viven en el servidor,
#     en Supabase Edge secrets o en los secrets de GitHub Actions.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# apps/web (Next.js) — variables PÚBLICAS (llegan al navegador)
# ───────────────────────────────────────────────────────────────────────────
# URL del proyecto Supabase. Formato: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon/public key. Protegida por RLS: sin RLS sería un riesgo, con RLS es
# únicamente el punto de entrada público. Es aceptable publicarla.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origen permitido para CORS y redirecciones de autenticación
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zona horaria y moneda por defecto de la organización
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota
NEXT_PUBLIC_DEFAULT_CURRENCY=COP

# ───────────────────────────────────────────────────────────────────────────
# Supabase — CLI / servidor / CI (SECRETAS)
# ───────────────────────────────────────────────────────────────────────────
# Project ref de tu proyecto en Supabase
SUPABASE_PROJECT_REF=
# Contraseña de la base de datos (solo local/CI; en Supabase-hosted es la que
# definiste al crear el proyecto)
SUPABASE_DB_PASSWORD=
# Token personal de la CLI: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Service role key: bypasea RLS. SOLO en Edge Functions y scripts de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────────────────────────────────────────────────────────
# Edge Functions / AgroIA (SECRETAS — nunca en el frontend)
# ───────────────────────────────────────────────────────────────────────────
# Cargar con:  supabase secrets set --env-file supabase/.env
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0
# Presupuesto mensual por organización (COP) para controlar consumo
AI_MONTHLY_BUDGET_COP=50000

# ───────────────────────────────────────────────────────────────────────────
# apps/mobile (Expo) — variables PÚBLICAS
# ───────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_VARIANT=development

# ───────────────────────────────────────────────────────────────────────────
# Builds móviles (EAS) — se configuran en eas.json y GitHub Secrets
# ───────────────────────────────────────────────────────────────────────────
# EAS_TOKEN (secret, nunca en el repositorio)

# ───────────────────────────────────────────────────────────────────────────
# Tooling general
# ───────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Etiqueta de entorno: development | staging | production
APP_ENV=development
